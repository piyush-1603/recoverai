// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Connection URL is configured in prisma.config.ts (Prisma 7 requirement)
}

model Transaction {
  id                          String    @id @default(cuid())
  externalPaymentId           String?   @unique
  amountPaise                 Int
  status                      String    // failed | recovered | unrecoverable | pending
  reasonCode                  String    @default("")
  source                      String    @default("customer") // customer | business | gateway | razorpay
  type                        String    // payment | subscription | checkout_abandon
  customerTier                String    @default("standard") // vip | standard | trial
  customerId                  String
  retryCount                  Int       @default(0)
  nudgeCount                  Int       @default(0)
  createdAt                   DateTime  @default(now())
  abandonedAt                 DateTime? // timestamp for checkout_abandon carts
  resolvedAt                  DateTime?
  recovered                   Boolean   @default(false)
  expectedRecoveryOutcome     String    // 'recovers_on_retry' | 'recovers_on_nudge' | 'requires_approval_then_recovers' | 'never_recovers'
  simulatedRecoveryAmountPaise Int?     // null if never_recovers
  // Marks a transaction created purely to demonstrate live execution (dashboard
  // demo buttons, resilience tests). Deliberately EXCLUDED from the headline
  // benchmark metrics so a live demo can never inflate or degrade the frozen
  // 65-transaction baseline. Audit rows for these ARE still shown in the ledger.
  isDemoArtifact              Boolean   @default(false)

  auditLogs AuditLog[]
}

model AuditLog {
  id            String      @id @default(cuid())
  transactionId String
  eventId       String      @unique // idempotency key
  actor         String      // 'ai_agent' | 'policy_engine' | 'action_executor' | 'system' | 'webhook' | 'policy_engine_override' | 'ai_agent+policy_engine'. Historical rows also carry 'claude_agent+policy_engine' (see lib/audit-logger.ts).
  action        String
  reason        String
  result        String
  provider      String?     // AI provider that produced the advisory recommendation (e.g. 'Google Gemini'). NULL on rows written before provider instrumentation existed — deliberately not backfilled.
  model         String?     // Exact model id (e.g. 'gemini-3.5-flash-lite'). NULL on pre-instrumentation rows.
  policyVersion String      @default("v1")
  timestamp     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model PolicyConfig {
  id                    String @id @default(cuid())
  afaThresholdPaise     Int    @default(1500000) // ₹15,000 — merchant-configurable
  maxRetries            Int    @default(1)
  vipMaxRetries         Int    @default(3)
  standardMaxRetries    Int    @default(1)
  trialMaxRetries       Int    @default(1)
  maxNudges             Int    @default(2)
  nudgeWindowStartHour  Int    @default(10)
  nudgeWindowEndHour    Int    @default(21)
}
