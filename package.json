{
  "name": "recoverai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:backend": "npx tsx server/server.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:frontend": "next start",
    "start:backend": "npx tsx server/server.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "npx tsx --tsconfig tsconfig.scripts.json data/seed-transactions.ts",
    "policy-check": "npx tsx --tsconfig tsconfig.scripts.json scripts/run-policy-check.ts",
    "test:off-window": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-off-window.ts",
    "test:retry-exhaustion": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-retry-exhaustion.ts",
    "test:idempotency": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-webhook-idempotency.ts",
    "test:demo-trigger-guard": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-demo-trigger-guard.ts",
    "test:webhook-processing-failure": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-webhook-processing-failure.ts",
    "test:e2e": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-end-to-end-trace.ts",
    "test:razorpay": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-razorpay-call.ts",
    "checkout:live": "npx tsx --tsconfig tsconfig.scripts.json scripts/create-live-checkout.ts",
    "demo": "npx tsx --tsconfig tsconfig.scripts.json scripts/run-demo.ts",
    "restore-baseline": "rm -f dev.db-wal dev.db-shm && cp dev.db.locked-baseline dev.db",
    "test:abandonment": "npx tsx --tsconfig tsconfig.scripts.json scripts/debug-abandonment.ts",
    "test:advisory-unavailable": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-advisory-unavailable.ts",
    "test:demo-isolation": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-demo-baseline-isolation.ts",
    "test:provider-attribution": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-provider-attribution.ts",
    "test:conflict-guard": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-webhook-conflict-guard.ts",
    "test:all": "npm run test:off-window && npm run test:retry-exhaustion && npm run test:idempotency && npm run test:conflict-guard && npm run test:demo-isolation && npm run test:advisory-unavailable && npm run test:webhook-processing-failure && npm run test:provider-attribution && npm run test:webhook-events && npm run test:p2p-watchdog && npm run test:smart-router && npm run test:webhook-simulator",
    "test:p2p": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-p2p-workflow.ts",
    "db:migrate-baseline": "npx tsx --tsconfig tsconfig.scripts.json scripts/migrate-baseline-schema.ts",
    "test:webhook-events": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-webhook-event-coverage.ts",
    "test:policy-parity": "npx tsx --tsconfig tsconfig.scripts.json scripts/verify-policy-parity.ts",
    "test:p2p-watchdog": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-p2p-watchdog.ts",
    "test:smart-router": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-smart-router.ts",
    "test:webhook-simulator": "npx tsx --tsconfig tsconfig.scripts.json scripts/test-webhook-simulator.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.19.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
